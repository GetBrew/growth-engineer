# Normalize line endings on check-in, check out as-is. Prevents CRLF/LF churn
# between macOS, Linux and Windows contributors.
* text=auto eol=lf

# Lockfiles and generated artifacts: text, but never diff-rendered — GitHub
# collapses them in review so a real change is not buried under 4,000 lines.
pnpm-lock.yaml linguist-generated=true -diff
convex/_generated/** linguist-generated=true -diff

# Binary assets: no EOL normalization, no diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.pdf binary
