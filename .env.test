# COMMITTED, NON-SECRET placeholders. This file is what keeps the suite
# hermetic: `pnpm test:run` and `pnpm test:convex` are green on a fresh clone
# with no credentials, so CI runners and cloud agents need zero setup.
#
# Add a variable here only when a test fails without it, and never add a real
# secret — those go in .env.test.local, which is gitignored. Build-time
# placeholders belong in the CI workflow, not here.
#
# The Convex authorization tests assert BOTH directions of the trusted
# transport: a forged token refused, the real one accepted. Without this value
# the positive case cannot run, so removing it fails the suite rather than
# quietly weakening it.
CONVEX_SERVICE_TOKEN=test-service-token-placeholder
