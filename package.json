{
  "name": "growth-engineer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "growth.engineer — the agent-friendly marketplace for go-to-market tools and workflows. Every tool and workflow is one markdown file any agent can run.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:convex": "convex dev",
    "dev:all": "concurrently -k -n next,convex -c blue,magenta \"pnpm dev\" \"pnpm dev:convex\"",
    "build": "node scripts/heavy-lock.mjs build -- pnpm build:raw",
    "build:raw": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" next build --turbopack",
    "start": "next start",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck:fast": "tsgo --noEmit",
    "check": "node scripts/heavy-lock.mjs check -- pnpm check:raw",
    "check:raw": "concurrently -n lint,types -c yellow,cyan \"pnpm lint\" \"pnpm typecheck:fast\" && node scripts/check-convex-codegen-fresh.mjs --advisory",
    "tsc": "node scripts/heavy-lock.mjs typecheck -- node scripts/typecheck.mjs",
    "test": "vitest",
    "test:run": "node scripts/heavy-lock.mjs tests -- vitest run",
    "test:convex": "node scripts/heavy-lock.mjs convex-tests -- vitest run --config vitest.convex.config.ts",
    "knip": "node scripts/heavy-lock.mjs knip -- knip",
    "docs:check": "node scripts/check-docs.mjs",
    "convex:codegen:check": "node scripts/check-convex-codegen-fresh.mjs",
    "deps:dedupe:check": "pnpm dedupe --check",
    "hygiene": "pnpm docs:check && pnpm convex:codegen:check && pnpm knip && pnpm deps:dedupe:check",
    "perf:bundle": "node scripts/client-bundle-budget.mjs --mode=check",
    "perf:bundle:snapshot": "node scripts/client-bundle-budget.mjs --mode=snapshot",
    "cache:prune": "node scripts/prune-next-dev-cache.mjs",
    "validate": "pnpm lint && pnpm tsc && pnpm test:run && pnpm test:convex",
    "seed": "convex run seed/run:run",
    "seed:reset": "convex run seed/run:reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "0.1.114",
    "gsap": "^3.15.0",
    "motion": "^13.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.5",
    "convex-test": "0.0.54",
    "jsdom": "^28.1.0",
    "knip": "^6.34.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "^7.10.0",
    "vite": "8.0.8",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.11"
  }
}
