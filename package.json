{
  "name": "growth-engineer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "description": "growth.engineer — the open-source catalog of go-to-market tools and workflows. Every tool and workflow is one markdown file any agent can run.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/heavy-lock.mjs build -- pnpm build:raw",
    "build:raw": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" next build --turbopack",
    "start": "next start",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck:fast": "tsgo --noEmit",
    "check": "node scripts/heavy-lock.mjs check -- pnpm check:raw",
    "check:raw": "concurrently -n lint,types -c yellow,cyan \"pnpm lint\" \"pnpm typecheck:fast\"",
    "tsc": "node scripts/heavy-lock.mjs typecheck -- node scripts/typecheck.mjs",
    "test": "vitest",
    "test:run": "node scripts/heavy-lock.mjs tests -- vitest run",
    "content:check": "vitest run tests/content.test.ts tests/content-schema.test.ts",
    "knip": "node scripts/heavy-lock.mjs knip -- knip",
    "docs:check": "node scripts/check-docs.mjs",
    "deps:dedupe:check": "pnpm dedupe --check",
    "hygiene": "pnpm docs:check && pnpm content:check && pnpm knip && pnpm deps:dedupe:check",
    "perf:bundle": "node scripts/client-bundle-budget.mjs --mode=check",
    "perf:bundle:snapshot": "node scripts/client-bundle-budget.mjs --mode=snapshot",
    "cache:prune": "node scripts/prune-next-dev-cache.mjs",
    "validate": "pnpm lint && pnpm tsc && pnpm test:run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@upstash/redis": "^1.39.0",
    "@usenotra/geo": "^0.5.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^10.0.5",
    "jsdom": "^28.1.0",
    "knip": "^6.34.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "^7.10.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.11"
  }
}
