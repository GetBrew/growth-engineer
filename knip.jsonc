{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead code is not a style problem — it is code that still typechecks, still
  // lints, still gets refactored by hand, and is never run. knip finds the
  // files, exports and dependencies nothing reaches.
  //
  // `exports` / `types` are WARNINGS on purpose, and the current list is a
  // CLOSED SET, not noise: `tenantMutation` and `systemQuery` complete the
  // gateway's read/write × human/machine matrix (shipping half of it would
  // make the next caller invent a fifth transport), and `AppErrorCode` is the
  // public type of the error payload. Everything else was deleted rather than
  // shipped unused. If this list grows, delete the addition or use it.
  //
  // Unused FILES and unused DEPENDENCIES stay errors — those are never
  // intentional.
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  },
  // Entry points knip cannot infer on its own. Next's own files (next.config,
  // proxy, app/**) and the Vitest configs are auto-detected — listing them
  // again just makes the config lie as those conventions change.
  //
  // The `!` suffix on the Convex glob marks those modules as entry points whose
  // EXPORTS are also entry points: a Convex function is called by name over the
  // wire, so nothing in this repo imports it.
  // `vitest.convex.config.ts` is listed because knip auto-detects only the
  // DEFAULT Vitest config; a second runner is invisible to it.
  "entry": [
    "convex/**/*.{ts,tsx}!",
    "scripts/**/*.{ts,mjs}",
    "vitest.convex.config.ts"
  ],
  "project": ["**/*.{ts,tsx}"],
  // Loaded by Tailwind's own pipeline (app/globals.css), not by any module,
  // so knip cannot see the import. `shadcn` and `tw-animate-css` are the
  // stylesheets globals.css @imports.
  // gsap/@gsap/react: installed for animation work, not imported yet.
  "ignoreDependencies": [
    "tailwindcss",
    "shadcn",
    "tw-animate-css",
    "gsap",
    "@gsap/react"
  ],
  // Vendored agent skills (installed with `npx skills add`): docs and example
  // files for agents, not app code. Biome skips them for the same reason.
  "ignore": [".agents/**"]
}
