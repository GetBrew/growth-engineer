# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/

# Generated by `next typegen` / `next dev`, and its CONTENT depends on which
# one ran last. Tracked, it meant every typecheck dirtied the working tree with
# a file whose own header says not to edit it — which trains everyone to ignore
# `git status`. Regenerated automatically; CI and fresh clones are unaffected.
next-env.d.ts

# TypeScript incremental build info
*.tsbuildinfo

# Caches
.swc/
.turbo/
coverage/

# Environment
.env
.env.local
.env.*.local

# Convex local state
.convex/

# Vercel
.vercel

# Clerk (can contain secrets)
/.clerk/

# Editors / OS
.DS_Store
.idea/
*.swp
# .vscode is shared team config (the Biome wiring) minus local state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs and scratch
*.log
tmp/
