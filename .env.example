# Copy to `.env.local` (gitignored) and fill in. `pnpm dev` reads it.
# Every variable here is validated in lib/env.ts — a missing one fails once,
# loudly, naming itself, instead of surfacing as a 500 three layers away.

# ── Convex ──────────────────────────────────────────────────────────────────
# `npx convex dev` writes both of these for you on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Clerk ───────────────────────────────────────────────────────────────────
# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard → Webhooks → your endpoint → Signing Secret.
# Only needed once you point a webhook at /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET=

# ── Server → Convex ─────────────────────────────────────────────────────────
# A shared secret proving a Convex call came from OUR server. It is never a
# person's authority — the acting user rides alongside it (lib/convex/gateway.ts).
# Generate: openssl rand -hex 32
# Set the SAME value on the Convex deployment:
#   npx convex env set CONVEX_SERVICE_TOKEN <value>
CONVEX_SERVICE_TOKEN=

# ── Set on the CONVEX deployment, not here ──────────────────────────────────
# The Clerk frontend API URL, read by convex/auth.config.ts. Without it,
# ctx.auth.getUserIdentity() returns null forever and every guard refuses.
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev
