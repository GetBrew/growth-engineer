# Every variable is optional. Copy this file to `.env.local` (gitignored) only
# if you need one; each is validated in lib/env.ts.
#
# The catalog is built from the markdown files in this repository, so there is
# no backend and no auth provider. The secrets below are the copy counter's
# store, a GitHub token, Notra's ingest token and the newsletter's Brew key,
# all optional, and the CDN token maintainers upload logos with.

# Absolute origin of this deployment; `/llms.txt` and the file index use it.
# On Vercel it defaults to the deployment's own hostname, so set it only for
# a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The copy counter (a workflow's "Uses", Hot and Popular): Upstash Redis over
# REST. The Vercel Marketplace integration sets all three; pages read with the
# read-only token, and only the count route writes. `UPSTASH_REDIS_REST_URL` /
# `_TOKEN` work too. Unset, every count is hidden and nothing else changes.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# The header's GitHub star count is read once per build. Unauthenticated, the
# GitHub API allows 60 requests an hour per address; any token (no scopes
# needed) raises that. Unset, the count may be missing from a build.
GITHUB_TOKEN=

# AI-traffic analytics (Notra GEO). The proxy reports each page view, file
# and /llms.txt fetch to Notra, which keeps AI crawlers and visits referred by
# an AI assistant and drops the rest. Set it in production only; unset,
# nothing is sent.
NOTRA_GEO_TOKEN=

# The footer's newsletter sign-up adds each subscriber to Brew (brew.new).
# Create a key at brew.new/settings/api, ideally for one brand and with the
# contacts permission only; an organization's key also needs its brand in
# BREW_BRAND_ID. Each new address is checked with Brew first (2 credits), and
# the copy counter's store above, when set, limits a visitor to 5 tries an
# hour. Unset, the sign-up is hidden. BREW_WELCOME_TRIGGER_ID is a Brew
# custom trigger (an `email` field) whose published automation sends the
# welcome email; unset, no welcome is sent.
BREW_API_KEY=
BREW_BRAND_ID=
BREW_WELCOME_TRIGGER_ID=

# MAINTAINERS ONLY. The token for the `growtheng-cdn` Vercel Blob store behind
# cdn.growth.engineer, which `pnpm logos:upload` puts company logos with
# (docs/maintainers/logos.md). Copy it from the Vercel dashboard (Storage,
# growtheng-cdn, tokens) into .env.local, never into chat or a commit. The
# site never reads it, so no deployment sets it.
GROWTH_ENGINEER_BLOB_READ_WRITE_TOKEN=
