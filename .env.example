# Copy to `.env.local` (gitignored) and fill in. Every variable is validated in
# lib/env.ts — a missing one fails once, loudly, naming itself.

# ── Convex ──────────────────────────────────────────────────────────────────
# `npx convex dev` writes these on first run. A `dev:` deploy key lets the CLI
# push and run functions headlessly (agents, CI); never commit one.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin; `/llms.txt` and the file index use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# logos.context.dev public client id. Optional: local logos only when absent.
NEXT_PUBLIC_CONTEXT_LOGO_CLIENT_ID=

# ── Clerk ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET=

# ── Server → Convex ─────────────────────────────────────────────────────────
# A shared secret proving a Convex call came from OUR server (and gating the
# revalidate route). Generate: openssl rand -hex 32 — then set the SAME value
# on the deployment: npx convex env set CONVEX_SERVICE_TOKEN <value>
CONVEX_SERVICE_TOKEN=

# ── Set on the CONVEX deployment, not here ──────────────────────────────────
# The Clerk frontend API URL, read by convex/auth.config.ts. Leave it EMPTY
# until Clerk exists: the deployment is then read-only for humans and every
# public read still works.
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev
