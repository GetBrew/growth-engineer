# Copy to `.env.local` (gitignored) and fill in. Every variable is validated in
# lib/env.ts — a missing one fails once, loudly, naming itself.
#
# There is no backend and no auth provider: the catalog is built from the
# markdown files in this repository, so nothing here is a secret.

# Absolute origin of this deployment; `/llms.txt` and the file index use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
